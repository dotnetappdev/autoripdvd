<Page
    x:Class="AutoRipDVD.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoRipDVD.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Monitor active ripping jobs" 
                               Style="{StaticResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OpenDiscButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE958;" FontSize="16"/>
                            <TextBlock Text="Open Disc"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="StartRippingButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock Text="Start Auto-Rip"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="StopRippingButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                            <TextBlock Text="Stop Auto-Rip"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="ViewDiscInfoButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="16"/>
                            <TextBlock Text="Info"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Active Jobs -->
        <Grid Grid.Row="1">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="Active Jobs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                    
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveJobs, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:RipJob">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{x:Bind Metadata.Title, Mode=OneWay}" 
                                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                                            <TextBlock Text="{x:Bind Disc.VolumeLabel, Mode=OneWay}" 
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" 
                                                       Foreground="White"
                                                       FontSize="12"/>
                                        </Border>

                                        <!-- Operation -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind CurrentOperation, Mode=OneWay}"
                                                   Margin="0,8,0,8"/>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Value="{x:Bind Progress, Mode=OneWay}"
                                                     Maximum="100"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <Border Height="200" 
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind HasNoActiveJobs, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C1;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="No active jobs" 
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Insert a disc to start ripping" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Recent Logs Header -->
        <TextBlock Grid.Row="2" 
                   Text="Recent Logs" 
                   Style="{StaticResource SubtitleTextBlockStyle}" 
                   Margin="0,24,0,12"/>

        <!-- Recent Logs -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentLogs, Mode=OneWay}" Margin="16">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" 
                                       FontFamily="Consolas" 
                                       FontSize="12"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
