<Page
    x:Class="AutoRipDVD.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoRipDVD.Models"
    xmlns:local="using:AutoRipDVD.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
        <local:BoolInverseConverter             x:Key="BoolInverseConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="DVD / Blu-ray Automatic Ripper"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <!-- Start / Stop Auto-Rip -->
                <Button x:Name="StartRipBtn"
                        Click="StartRippingButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Enable auto-rip: discs are ripped automatically when inserted">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="Start Auto-Rip"/>
                    </StackPanel>
                </Button>

                <Button x:Name="StopRipBtn"
                        Click="StopRippingButton_Click"
                        ToolTipService.ToolTip="Stop auto-rip and cancel active jobs">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                        <TextBlock Text="Stop Auto-Rip"/>
                    </StackPanel>
                </Button>

                <AppBarSeparator/>

                <!-- Manual rip for inserted disc – disabled until a disc is detected -->
                <Button x:Name="OpenDiscButton"
                        Click="OpenDiscButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasDiscInserted, Mode=OneWay}"
                        ToolTipService.ToolTip="Select titles from the inserted disc">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE958;" FontSize="16"/>
                        <TextBlock Text="Open Disc"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DiscInfoButton"
                        Click="ViewDiscInfoButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasDiscInserted, Mode=OneWay}"
                        ToolTipService.ToolTip="Show info about the currently inserted disc">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="16"/>
                        <TextBlock Text="Disc Info"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- ══ Rip Options ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="0,0,0,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid ColumnSpacing="24" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Content Type -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Content Type" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="MovieRadio"
                                     Content="Movie"
                                     GroupName="ContentType"
                                     Checked="ContentType_Checked"/>
                        <RadioButton x:Name="TvSeriesRadio"
                                     Content="TV Series"
                                     GroupName="ContentType"
                                     Checked="ContentType_Checked"/>
                    </StackPanel>
                </StackPanel>

                <!-- Output Path Overrides (per-media) -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock FontWeight="SemiBold" FontSize="13">
                        <Run Text="Output Path"/>
                        <Run Text="  (per-media overrides, leave blank to use Settings path)"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             FontWeight="Normal" FontSize="11"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="MoviesOutputPathBox" Width="420"
                                 PlaceholderText="{x:Bind ViewModel.EffectiveOutputPath, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.MoviesOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.IsMovieType, Mode=OneWay}"
                                 LostFocus="MoviesOutputPathBox_LostFocus"/>
                        <Button x:Name="BrowseMoviesBtn" Click="BrowseMoviesOutputPath_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="TvOutputPathBox" Width="420"
                                 PlaceholderText="{x:Bind ViewModel.EffectiveOutputPath, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.TvOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.IsMovieType, Converter={StaticResource BoolInverseConverter}, Mode=OneWay}"
                                 LostFocus="TvOutputPathBox_LostFocus"/>
                        <Button x:Name="BrowseTvBtn" Click="BrowseTvOutputPath_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Browse / Renamer column -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BrowseOutputBtn" Click="BrowseOutputPath_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="Set Global Output"/>
                        </StackPanel>
                        </Button>
                        <ComboBox x:Name="RecentFoldersCombo" Width="280" PlaceholderText="Recent folders" SelectionChanged="RecentFoldersCombo_SelectionChanged"/>
                    </StackPanel>
                    <Button x:Name="OpenRenamerButton" Click="OpenRenamer_Click" ToolTipService.ToolTip="Open renamer / matcher dialog">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EF;" FontSize="14"/>
                            <TextBlock Text="Rename Files"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Active Jobs ═══════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
                <TextBlock Text="Active Jobs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveJobs, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:RipJob">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16" Margin="0,0,0,10">
                                <StackPanel Spacing="10">

                                    <!-- ── Title / Status row ─────────────────────────── -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Metadata.Title, Mode=OneWay}"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Disc.VolumeLabel, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="10,4" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- ── Simple progress (non-ripping states) ──────── -->
                                    <StackPanel Visibility="{x:Bind HasRipStats, Converter={StaticResource BoolToVisibilityInverseConverter}, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind CurrentOperation, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,6"/>
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                     Maximum="100"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"/>
                                    </StackPanel>

                                    <!-- ── MakeMKV-style stats panel (ripping state) ─── -->
                                    <Border Visibility="{x:Bind HasRipStats, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="8">

                                            <!-- Information table -->
                                            <TextBlock Text="Information"
                                                       FontWeight="SemiBold" FontSize="13"/>

                                            <Grid ColumnSpacing="8" RowSpacing="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Source -->
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Source :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{x:Bind RipStats.Source, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Source file -->
                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Source file :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind RipStats.SourceFile, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Source size -->
                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="Source size :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{x:Bind RipStats.SourceSize, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"/>

                                                <!-- Read rate -->
                                                <TextBlock Grid.Row="3" Grid.Column="0"
                                                           Text="Read rate :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                                                           Text="{x:Bind RipStats.ReadRate, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"/>

                                                <!-- Output file -->
                                                <TextBlock Grid.Row="4" Grid.Column="0"
                                                           Text="Output file :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1"
                                                           Text="{x:Bind RipStats.OutputFile, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Output size -->
                                                <TextBlock Grid.Row="5" Grid.Column="0"
                                                           Text="Output size :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1"
                                                           Text="{x:Bind RipStats.OutputSize, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"/>

                                                <!-- Free space -->
                                                <TextBlock Grid.Row="6" Grid.Column="0"
                                                           Text="Free space :" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1"
                                                           Text="{x:Bind RipStats.FreeSpace, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="11"/>
                                            </Grid>

                                            <!-- Per-title progress bar -->
                                            <Grid Margin="0,6,0,0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind RipStats.TitleProgressLabel, Mode=OneWay}"
                                                           FontSize="12"/>
                                                <TextBlock Grid.Column="1" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Elapsed: "/>
                                                    <Run Text="{x:Bind RipStats.TitleElapsedFormatted, Mode=OneWay}"/>
                                                    <Run Text=" / Remaining: "/>
                                                    <Run Text="{x:Bind RipStats.TitleRemainingFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind RipStats.TitleProgressValue, Mode=OneWay}"
                                                         Maximum="100" Height="14"/>

                                            <!-- Overall progress bar -->
                                            <Grid Margin="0,4,0,0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind RipStats.OverallProgressLabel, Mode=OneWay}"
                                                           FontSize="12"/>
                                                <TextBlock Grid.Column="1" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Elapsed: "/>
                                                    <Run Text="{x:Bind RipStats.OverallElapsedFormatted, Mode=OneWay}"/>
                                                    <Run Text=" / Remaining: "/>
                                                    <Run Text="{x:Bind RipStats.OverallRemainingFormatted, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind RipStats.OverallProgressValue, Mode=OneWay}"
                                                         Maximum="100" Height="14"/>

                                            <!-- Log messages (title added / skipped) -->
                                            <Border Margin="0,8,0,0"
                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    MaxHeight="130">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsRepeater ItemsSource="{x:Bind RipStats.Messages, Mode=OneWay}"
                                                                   Margin="8,6">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{x:Bind}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           TextWrapping="NoWrap"
                                                                           Margin="0,1"/>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                            </Border>

                                        </StackPanel>
                                    </Border>

                                    <!-- Output path (when complete) -->
                                    <TextBlock Text="{x:Bind OutputPath, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind HasOutputPath, Mode=OneWay}"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state -->
                <Border Height="180"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasNoActiveJobs, Mode=OneWay}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE7C1;" FontSize="48"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No active rip jobs"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Insert a DVD or Blu-ray, or click 'Open Disc' to rip manually"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Recent Logs header ════════════════════════════════════════════ -->
        <TextBlock Grid.Row="3"
                   Text="Recent Logs"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="0,20,0,10"/>

        <!-- ══ Recent Logs ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentLogs, Mode=OneWay}" Margin="16">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}"
                                       FontFamily="Consolas" FontSize="11"
                                       Margin="0,2" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
